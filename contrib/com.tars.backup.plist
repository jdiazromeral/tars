<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tars.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/tars</string>
    <string>backup</string>
    <string>__HOME__/backups/tars-vault</string>
    <string>--keep</string>
    <string>14</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TARS_HOME</key>
    <string>__HOME__/tars-vault</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/tars-backup.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/tars-backup.log</string>
</dict>
</plist>
